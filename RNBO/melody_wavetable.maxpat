,
											"classnamespace" : "dsp.gen",
											"rect" : [ 103.0, 161.0, 787.0, 665.0 ],
											"gridsize" : [ 15.0, 15.0 ],
											"boxes" : [ 												{
													"box" : 													{
														"maxclass" : "codebox",
														"patching_rect" : [ 41.0, 59.0, 719.0, 534.0 ],
														"fontsize" : 12.0,
														"numoutlets" : 1,
														"outlettype" : [ "" ],
														"fontname" : "<Monospaced>",
														"fontface" : 0,
														"numinlets" : 2,
														"id" : "obj-3",
														"code" : "History phase(0);   // Internal phasor\r\nHistory h1(0);      // History for filter\r\nHistory h2(0);      // History for filter\r\nHistory oldsr(0);   // Keep track of whether the sample rate changed\r\nHistory freq(0);    // Keep track of whether the frequency changed\r\nHistory os(4);      // Oversampling factor\r\nHistory realsr(0);  // \"Real\" samplerate, the sampling rate * oversampling factor\r\n\r\n\r\n// Get in the wavetable\r\nBuffer osc_wavetable_buf(\"wavetable_buf\");\r\nParam framesize(256);\r\nnumFrames = clamp(floor(dim(osc_wavetable_buf) / framesize), 0, dim(osc_wavetable_buf));\r\n\r\n\r\n\r\n// Adjust samplerate and freq for this oversampled phasor as needed\r\nif ((oldsr != samplerate) || freq != in1) {\r\n\t// scale the incoming frequency to a range from 0 to 1. Everything from 200 \r\n    // Hz and below will only be oversampled 2 times, and everything above 1200 Hz\r\n    // will be oversampled 16 times.\r\n    os = int ((44100 / samplerate) * (2 + (14 * (scale(in1, 200, 1200, 0, 1, 0.5)))));\r\n    if (os ==0) os = 1;\r\n    \r\n\trealsr = samplerate * os; \r\n\toldsr = samplerate;\r\n\tfreq = in1;\r\n}\r\n\r\n\r\nt = 0;\r\nomega, _sin, _cos = 0;\r\n\r\nframe_pos, table_pos, terrain_pos, frame_pos_frac, table_pos_frac = 0;\r\nbottom_left, bottom_right, top_left, top_right = 0;\r\nabove, below, frame_pos_left, frame_pos_right = 0;\r\ntable_pos_bottom, table_pos_top = 0;\r\n\r\nfor (i = 0; i < os; i += 1) {\r\n\tt = wrap(phase, 0, 1);\r\n\tphase = fixdenorm(t + (in1 / realsr));\r\n\t\r\n\t\r\n\t/// ----\r\n\tframe_pos = t * framesize;\r\n\tterrain_pos = in2;\r\n\t\r\n\t// Position in the frame\r\n\tframe_pos_left = int(frame_pos);\r\n\tframe_pos_right = 0;\r\n\tif (frame_pos_left == framesize - 1) {\r\n\t\t// End of frame, so wrap to beginning\r\n\t\tframe_pos_right = 0;\r\n\t}\r\n\telse {\r\n\t\tframe_pos_right = frame_pos_left + 1;\r\n\t}\r\n\tframe_pos_frac = frame_pos - frame_pos_left;\r\n\t\r\n\t// Position in the table\r\n\ttable_pos = terrain_pos * (numFrames - 1);  // scale from [0..1] to [0..table_size - 1]\r\n\ttable_pos_bottom = floor(table_pos);\r\n\ttable_pos_top = ceil(table_pos);\r\n\ttable_pos_frac = table_pos - table_pos_bottom;  // [0..1]\r\n\t\r\n\t// Look up nearby samples\r\n\tbottom_left = peek(osc_wavetable_buf, framesize * table_pos_bottom + frame_pos_left);\r\n\tbottom_right = peek(osc_wavetable_buf, framesize * table_pos_bottom + frame_pos_right);\r\n\ttop_left = peek(osc_wavetable_buf, framesize * table_pos_top + frame_pos_left);\r\n\ttop_right = peek(osc_wavetable_buf, framesize * table_pos_top + frame_pos_right);\r\n\t\r\n\t// Interpolate within both of the two above and below frames\r\n\tbelow = bottom_left + frame_pos_frac * (bottom_right - bottom_left);\n\tabove = top_left + frame_pos_frac * (top_right - top_left);\r\n\tt = below + table_pos_frac * (above - below);\r\n\t/// ----\r\n\t\r\n\t\r\n\t// Low-pass the result\r\n\tomega = (20000 * twopi) / realsr;\r\n\t_sin = sin(omega);\r\n\t_cos = cos(omega);\r\n\t\r\n\tb0 = 1 / (1 + _sin);\r\n\ta2 = ((1 - _cos) * 0.5) * b0;\r\n\ta1 = (1 - _cos) * b0;\r\n\tb1 = (-2 * _cos) * b0;\r\n\tb2 = (1 - _sin) * b0;\r\n\t\r\n\tt = (((t * a2) + (h2 * a1)) + (h1 * a2)) - ((h1 * b2) + (h2 * b1));\r\n\t\r\n\th1 = fixdenorm(h2);\r\n\th2 = fixdenorm(t);\r\n}\r\n\r\nout1 = t;\r\n"
													}

												}
