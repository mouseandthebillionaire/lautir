                                                    "patching_rect": [ 1786.0, 718.0, 50.0, 23.0 ],
                                                    "rnbo_classname": "number",
                                                    "rnbo_extra_attributes": {
                                                        "order": "",
                                                        "maximum": "<none>",
                                                        "minimum": "<none>",
