                                                    "parameter_enable": 0,
                                                    "patching_rect": [ 1244.0, 718.0, 50.0, 23.0 ],
                                                    "rnbo_classname": "number",
                                                    "rnbo_extra_attributes": {
                                                        "order": "",
                                                        "maximum": "<none>",
                                                        "minimum": "<none>",
                                                        "initialFormat": "integer",
