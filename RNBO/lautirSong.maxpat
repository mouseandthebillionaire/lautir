                                            },
                                            {
                                                "box": {
                                                    "genpatcher": {
                                                        "patcher": {
                                                            "fileversion": 1,
                                                            "appversion": {
                                                                "major": 9,
                                                                "minor": 1,
                                                                "revision": 4,
