                                                                            "boxes": [
                                                                                {
                                                                                    "box": {
                                                                                        "maxclass": "newobj",
                                                                                        "text": "in 2 @comment trigger",
                                                                                        "patching_rect": [ 215.55999755859375, 62.0, 133.0, 22.0 ],
                                                                                        "id": "obj-3",
                                                                                        "numinlets": 0,
                                                                                        "numoutlets": 1,
                                                                                        "outlettype": [ "" ]
                                                                                    }
                                                                                },
                                                                                {
                                                                                    "box": {
                                                                                        "maxclass": "newobj",
                                                                                        "text": "in 6 @min 0.1 @default 150. @comment release",
                                                                                        "patching_rect": [ 985.7999877929688, 56.0, 271.0, 22.0 ],
                                                                                        "id": "obj-9",
                                                                                        "numinlets": 0,
                                                                                        "numoutlets": 1,
