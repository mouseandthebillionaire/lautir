                                                }
                                            },
                                            {
                                                "box": {
                                                    "format": 0,
                                                    "id": "obj-155",
                                                    "maxclass": "number",
                                                    "numinlets": 1,
                                                    "numoutlets": 2,
                                                    "outlettype": [ "", "bang" ],
                                                    "parameter_enable": 0,
                                                    "patching_rect": [ 1244.0, 718.0, 50.0, 23.0 ],
                                                    "rnbo_classname": "number",
                                                    "rnbo_extra_attributes": {
                                                        "order": "",
                                                        "maximum": "<none>",
                                                        "minimum": "<none>",
                                                        "initialFormat": "integer",
                                                        "preset": 0
                                                    },
                                                    "rnbo_serial": 20,
                                                    "rnbo_uniqueid": "number_obj-155"
                                                }
                                            },
                                            {
                                                "box": {
                                                    "code": "// RNBO codebox (event-rate) bassline picker + deterministic density\n//\n// Inlets:\n// in1: basslineId (0..27)\n// in2: density (0..7) 0=>2 hits per half (4 total), 7=>16 per half (32 total, no rests)\n// Rest pattern in steps 16..31 mirrors steps 0..15\n//\n// Outlet:\n// listout1: 32 integers, MIDI notes, with -1 for rests\n\n@state melodies = new FixedIntArray(28, 32);\n@state melodiesReady: Int = 0;\n\n// Begin Bassline\n\nfunction aMinorStep(idx) {\n // A natural minor from A: A B C D E F G = 0,2,3,5,7,8,10\n idx = idx % 7;\n if (idx == 0) return 0;  // A\n if (idx == 1) return 2;  // B\n if (idx == 2) return 3;  // C\n if (idx == 3) return 5;  // D\n if (idx == 4) return 7;  // E\n if (idx == 5) return 8;  // F\n return 10;               // G\n}\n\nfunction init() {\n var m = 0;\n var i = 0;\n var phrase = 0;\n var degree = 0;\n var note = 0;\n var baseA = 33; // A1\n var pattern = 0;\n var useLeadingTone = 0;\n\n while (m < 28) {\n  i = 0;\n  pattern = m % 7;\n\n  while (i < 32) {\n   phrase = i % 16;\n\n   // Bass-oriented 16-step contours.\n   // Mostly roots, fifths, octaves, and small approach tones.\n   if (pattern == 0) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 4;  // E\n    else if (phrase == 3) degree = 0;  // A\n    else if (phrase == 4) degree = 0;  // A\n    else if (phrase == 5) degree = 2;  // C\n    else if (phrase == 6) degree = 4;  // E\n    else if (phrase == 7) degree = 0;  // A\n    else if (phrase == 8) degree = 3;  // D\n    else if (phrase == 9) degree = 3;  // D\n    else if (phrase == 10) degree = 4; // E\n    else if (phrase == 11) degree = 3; // D\n    else if (phrase == 12) degree = 4; // E\n    else if (phrase == 13) degree = 6; // G/G#\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else if (pattern == 1) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 1;  // B\n    else if (phrase == 3) degree = 2;  // C\n    else if (phrase == 4) degree = 3;  // D\n    else if (phrase == 5) degree = 2;  // C\n    else if (phrase == 6) degree = 1;  // B\n    else if (phrase == 7) degree = 0;  // A\n    else if (phrase == 8) degree = 4;  // E\n    else if (phrase == 9) degree = 4;  // E\n    else if (phrase == 10) degree = 3; // D\n    else if (phrase == 11) degree = 2; // C\n    else if (phrase == 12) degree = 1; // B\n    else if (phrase == 13) degree = 6; // G/G#\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else if (pattern == 2) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 4;  // E\n    else if (phrase == 3) degree = 0;  // A\n    else if (phrase == 4) degree = 5;  // F\n    else if (phrase == 5) degree = 5;  // F\n    else if (phrase == 6) degree = 2;  // C\n    else if (phrase == 7) degree = 5;  // F\n    else if (phrase == 8) degree = 3;  // D\n    else if (phrase == 9) degree = 3;  // D\n    else if (phrase == 10) degree = 0; // A\n    else if (phrase == 11) degree = 3; // D\n    else if (phrase == 12) degree = 4; // E\n    else if (phrase == 13) degree = 4; // E\n    else if (phrase == 14) degree = 6; // G/G#\n    else degree = 0;                   // A\n   } else if (pattern == 3) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 0;  // A\n    else if (phrase == 3) degree = 4;  // E\n    else if (phrase == 4) degree = 0;  // A\n    else if (phrase == 5) degree = 0;  // A\n    else if (phrase == 6) degree = 2;  // C\n    else if (phrase == 7) degree = 4;  // E\n    else if (phrase == 8) degree = 5;  // F\n    else if (phrase == 9) degree = 5;  // F\n    else if (phrase == 10) degree = 5; // F\n    else if (phrase == 11) degree = 4; // E\n    else if (phrase == 12) degree = 3; // D\n    else if (phrase == 13) degree = 3; // D[2:07 PM]else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else if (pattern == 4) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 4;  // E\n    else if (phrase == 2) degree = 0;  // A\n    else if (phrase == 3) degree = 4;  // E\n    else if (phrase == 4) degree = 5;  // F\n    else if (phrase == 5) degree = 2;  // C\n    else if (phrase == 6) degree = 5;  // F\n    else if (phrase == 7) degree = 2;  // C\n    else if (phrase == 8) degree = 3;  // D\n    else if (phrase == 9) degree = 0;  // A\n    else if (phrase == 10) degree = 3; // D\n    else if (phrase == 11) degree = 0; // A\n    else if (phrase == 12) degree = 4; // E\n    else if (phrase == 13) degree = 6; // G/G#\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else if (pattern == 5) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 2;  // C\n    else if (phrase == 3) degree = 0;  // A\n    else if (phrase == 4) degree = 4;  // E\n    else if (phrase == 5) degree = 4;  // E\n    else if (phrase == 6) degree = 2;  // C\n    else if (phrase == 7) degree = 0;  // A\n    else if (phrase == 8) degree = 5;  // F\n    else if (phrase == 9) degree = 5;  // F\n    else if (phrase == 10) degree = 4; // E\n    else if (phrase == 11) degree = 3; // D\n    else if (phrase == 12) degree = 1; // B\n    else if (phrase == 13) degree = 1; // B\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 4;  // E\n    else if (phrase == 3) degree = 0;  // A\n    else if (phrase == 4) degree = 3;  // D\n    else if (phrase == 5) degree = 3;  // D\n    else if (phrase == 6) degree = 4;  // E\n    else if (phrase == 7) degree = 3;  // D\n    else if (phrase == 8) degree = 5;  // F\n    else if (phrase == 9) degree = 5;  // F\n    else if (phrase == 10) degree = 3; // D\n    else if (phrase == 11) degree = 5; // F\n    else if (phrase == 12) degree = 4; // E\n    else if (phrase == 13) degree = 6; // G/G#\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   }\n\n   note = baseA + aMinorStep(degree);\n\n   // Register variation, but still bass-range.\n   if ((m % 4) == 1) {\n    if (phrase >= 8) note = note + 12;\n   } else if ((m % 4) == 2) {\n    if (phrase == 2 || phrase == 6 || phrase == 10 || phrase == 14) note = note + 12;\n   } else if ((m % 4) == 3) {\n    if (phrase == 5 || phrase == 9 || phrase == 13) note = note + 12;\n   }\n\n   // Harmonic minor color: occasionally raise G -> G# near cadences.\n   useLeadingTone = 0;\n   if (degree == 6) {\n    if (phrase == 13 || phrase == 14) {\n     if ((m % 3) == 0) {\n      useLeadingTone = 1;\n     }\n    }\n   }\n   if (useLeadingTone == 1) {\n    note = note + 1;\n   }\n\n   // Keep in a bass-friendly range: A1 to A3.\n   while (note < 33) note = note + 12;\n   while (note > 57) note = note - 12;\n\n   melodies[m][i] = note;\n\n   i = i + 1;\n  }\n\n  m = m + 1;\n }\n}\n\n// End Bassline\n\nfunction clampInt(x, lo: Int, hi: Int) {\n let xi: Int = x;\n if (xi < lo) xi = lo;\n if (xi > hi) xi = hi;\n return xi;\n}\n\nif (melodiesReady == 0) {\n init();\n melodiesReady = 1;\n}\n\nlet basslineId: Int = clampInt(in1, 0, 27);\nlet density: Int = clampInt(in2, 0, 7);\nlet nHalf: Int = 2 + density * 2; // played positions per 16-step half\nif (nHalf > 16) nHalf = 16;\n\nlet offset: Int = basslineId % 16;\n\nlet out = [];\n\nfor (let step: Int = 0; step < 32; step += 1) {\n let p: Int = step % 16;\n let play: Int = 0;\n\n if (p == 0) play = 1; // downbeat of each half always plays\n\n // Evenly space hits around the half-phrase.\n for (let k: Int = 0; k < nHalf; k += 1) {\n  let s: Int = (offset + (k * 16) / nHalf) % 16;\n  if (s == p) play = 1;\n }\n\n let note: Int = melodies[basslineId][step];\n out.push(play == 1 ? note : -1);\n}\r\nlistout1 = out;",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-153",
                                                    "maxclass": "codebox",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 1332.0, 768.0, 473.33334743976593, 412.0000122785568 ],
                                                    "rnbo_classname": "codebox",
                                                    "rnbo_extra_attributes": {
                                                        "nocache": 0,
                                                        "hot": 0,
                                                        "code": "// RNBO codebox (event-rate) bassline picker + deterministic density\n//\n// Inlets:\n// in1: basslineId (0..27)\n// in2: density (0..7) 0=>2 hits per half (4 total), 7=>16 per half (32 total, no rests)\n// Rest pattern in steps 16..31 mirrors steps 0..15\n//\n// Outlet:\n// listout1: 32 integers, MIDI notes, with -1 for rests\n\n@state melodies = new FixedIntArray(28, 32);\n@state melodiesReady: Int = 0;\n\n// Begin Bassline\n\nfunction aMinorStep(idx) {\n // A natural minor from A: A B C D E F G = 0,2,3,5,7,8,10\n idx = idx % 7;\n if (idx == 0) return 0;  // A\n if (idx == 1) return 2;  // B\n if (idx == 2) return 3;  // C\n if (idx == 3) return 5;  // D\n if (idx == 4) return 7;  // E\n if (idx == 5) return 8;  // F\n return 10;               // G\n}\n\nfunction init() {\n var m = 0;\n var i = 0;\n var phrase = 0;\n var degree = 0;\n var note = 0;\n var baseA = 33; // A1\n var pattern = 0;\n var useLeadingTone = 0;\n\n while (m < 28) {\n  i = 0;\n  pattern = m % 7;\n\n  while (i < 32) {\n   phrase = i % 16;\n\n   // Bass-oriented 16-step contours.\n   // Mostly roots, fifths, octaves, and small approach tones.\n   if (pattern == 0) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 4;  // E\n    else if (phrase == 3) degree = 0;  // A\n    else if (phrase == 4) degree = 0;  // A\n    else if (phrase == 5) degree = 2;  // C\n    else if (phrase == 6) degree = 4;  // E\n    else if (phrase == 7) degree = 0;  // A\n    else if (phrase == 8) degree = 3;  // D\n    else if (phrase == 9) degree = 3;  // D\n    else if (phrase == 10) degree = 4; // E\n    else if (phrase == 11) degree = 3; // D\n    else if (phrase == 12) degree = 4; // E\n    else if (phrase == 13) degree = 6; // G/G#\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else if (pattern == 1) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 1;  // B\n    else if (phrase == 3) degree = 2;  // C\n    else if (phrase == 4) degree = 3;  // D\n    else if (phrase == 5) degree = 2;  // C\n    else if (phrase == 6) degree = 1;  // B\n    else if (phrase == 7) degree = 0;  // A\n    else if (phrase == 8) degree = 4;  // E\n    else if (phrase == 9) degree = 4;  // E\n    else if (phrase == 10) degree = 3; // D\n    else if (phrase == 11) degree = 2; // C\n    else if (phrase == 12) degree = 1; // B\n    else if (phrase == 13) degree = 6; // G/G#\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else if (pattern == 2) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 4;  // E\n    else if (phrase == 3) degree = 0;  // A\n    else if (phrase == 4) degree = 5;  // F\n    else if (phrase == 5) degree = 5;  // F\n    else if (phrase == 6) degree = 2;  // C\n    else if (phrase == 7) degree = 5;  // F\n    else if (phrase == 8) degree = 3;  // D\n    else if (phrase == 9) degree = 3;  // D\n    else if (phrase == 10) degree = 0; // A\n    else if (phrase == 11) degree = 3; // D\n    else if (phrase == 12) degree = 4; // E\n    else if (phrase == 13) degree = 4; // E\n    else if (phrase == 14) degree = 6; // G/G#\n    else degree = 0;                   // A\n   } else if (pattern == 3) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 0;  // A\n    else if (phrase == 3) degree = 4;  // E\n    else if (phrase == 4) degree = 0;  // A\n    else if (phrase == 5) degree = 0;  // A\n    else if (phrase == 6) degree = 2;  // C\n    else if (phrase == 7) degree = 4;  // E\n    else if (phrase == 8) degree = 5;  // F\n    else if (phrase == 9) degree = 5;  // F\n    else if (phrase == 10) degree = 5; // F\n    else if (phrase == 11) degree = 4; // E\n    else if (phrase == 12) degree = 3; // D\n    else if (phrase == 13) degree = 3; // D[2:07 PM]else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else if (pattern == 4) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 4;  // E\n    else if (phrase == 2) degree = 0;  // A\n    else if (phrase == 3) degree = 4;  // E\n    else if (phrase == 4) degree = 5;  // F\n    else if (phrase == 5) degree = 2;  // C\n    else if (phrase == 6) degree = 5;  // F\n    else if (phrase == 7) degree = 2;  // C\n    else if (phrase == 8) degree = 3;  // D\n    else if (phrase == 9) degree = 0;  // A\n    else if (phrase == 10) degree = 3; // D\n    else if (phrase == 11) degree = 0; // A\n    else if (phrase == 12) degree = 4; // E\n    else if (phrase == 13) degree = 6; // G/G#\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else if (pattern == 5) {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 2;  // C\n    else if (phrase == 3) degree = 0;  // A\n    else if (phrase == 4) degree = 4;  // E\n    else if (phrase == 5) degree = 4;  // E\n    else if (phrase == 6) degree = 2;  // C\n    else if (phrase == 7) degree = 0;  // A\n    else if (phrase == 8) degree = 5;  // F\n    else if (phrase == 9) degree = 5;  // F\n    else if (phrase == 10) degree = 4; // E\n    else if (phrase == 11) degree = 3; // D\n    else if (phrase == 12) degree = 1; // B\n    else if (phrase == 13) degree = 1; // B\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   } else {\n    if (phrase == 0) degree = 0;       // A\n    else if (phrase == 1) degree = 0;  // A\n    else if (phrase == 2) degree = 4;  // E\n    else if (phrase == 3) degree = 0;  // A\n    else if (phrase == 4) degree = 3;  // D\n    else if (phrase == 5) degree = 3;  // D\n    else if (phrase == 6) degree = 4;  // E\n    else if (phrase == 7) degree = 3;  // D\n    else if (phrase == 8) degree = 5;  // F\n    else if (phrase == 9) degree = 5;  // F\n    else if (phrase == 10) degree = 3; // D\n    else if (phrase == 11) degree = 5; // F\n    else if (phrase == 12) degree = 4; // E\n    else if (phrase == 13) degree = 6; // G/G#\n    else if (phrase == 14) degree = 4; // E\n    else degree = 0;                   // A\n   }\n\n   note = baseA + aMinorStep(degree);\n\n   // Register variation, but still bass-range.\n   if ((m % 4) == 1) {\n    if (phrase >= 8) note = note + 12;\n   } else if ((m % 4) == 2) {\n    if (phrase == 2 || phrase == 6 || phrase == 10 || phrase == 14) note = note + 12;\n   } else if ((m % 4) == 3) {\n    if (phrase == 5 || phrase == 9 || phrase == 13) note = note + 12;\n   }\n\n   // Harmonic minor color: occasionally raise G -> G# near cadences.\n   useLeadingTone = 0;\n   if (degree == 6) {\n    if (phrase == 13 || phrase == 14) {\n     if ((m % 3) == 0) {\n      useLeadingTone = 1;\n     }\n    }\n   }\n   if (useLeadingTone == 1) {\n    note = note + 1;\n   }\n\n   // Keep in a bass-friendly range: A1 to A3.\n   while (note < 33) note = note + 12;\n   while (note > 57) note = note - 12;\n\n   melodies[m][i] = note;\n\n   i = i + 1;\n  }\n\n  m = m + 1;\n }\n}\n\n// End Bassline\n\nfunction clampInt(x, lo: Int, hi: Int) {\n let xi: Int = x;\n if (xi < lo) xi = lo;\n if (xi > hi) xi = hi;\n return xi;\n}\n\nif (melodiesReady == 0) {\n init();\n melodiesReady = 1;\n}\n\nlet basslineId: Int = clampInt(in1, 0, 27);\nlet density: Int = clampInt(in2, 0, 7);\nlet nHalf: Int = 2 + density * 2; // played positions per 16-step half\nif (nHalf > 16) nHalf = 16;\n\nlet offset: Int = basslineId % 16;\n\nlet out = [];\n\nfor (let step: Int = 0; step < 32; step += 1) {\n let p: Int = step % 16;\n let play: Int = 0;\n\n if (p == 0) play = 1; // downbeat of each half always plays\n\n // Evenly space hits around the half-phrase.\n for (let k: Int = 0; k < nHalf; k += 1) {\n  let s: Int = (offset + (k * 16) / nHalf) % 16;\n  if (s == p) play = 1;\n }\n\n let note: Int = melodies[basslineId][step];\n out.push(play == 1 ? note : -1);\n}\r\nlistout1 = out;",
                                                        "safemath": 1
                                                    },
