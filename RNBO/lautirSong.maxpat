                                            {
                                                "box": {
                                                    "id": "obj-157",
                                                    "linecount": 2,
                                                    "maxclass": "message",
                                                    "numinlets": 2,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 1334.0, 1236.0, 281.33334171772003, 37.0 ],
                                                    "rnbo_classname": "message",
                                                    "rnbo_extra_attributes": {
