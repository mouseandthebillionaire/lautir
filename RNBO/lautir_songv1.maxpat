                                                                        "text": "in 5 @min 0. @max 1. @default 0.5 @comment sustain",
                                                                        "patching_rect": [ 793.239990234375, 24.0, 307.0, 22.0 ],
                                                                        "outlettype": [ "" ],
                                                                        "id": "obj-8",
