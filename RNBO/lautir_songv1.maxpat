                                                            "boxes": [
                                                                {
                                                                    "box": {
                                                                        "maxclass": "newobj",
                                                                        "text": "in 2 @comment trigger",
                                                                        "patching_rect": [ 215.55999755859375, 62.0, 133.0, 22.0 ],
                                                                        "outlettype": [ "" ],
